{
    "name": "tipowerup/testbench",
    "type": "library",
    "description": "Shared testing foundation for TI PowerUp extensions. Provides full Laravel + TastyIgniter context in tests with dual-mode support (host app and standalone CI).",
    "license": "MIT",
    "authors": [
        {
            "name": "TI PowerUp Team",
            "email": "support@tipowerup.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0"
    },
    "require-dev": {
        "laravel/pint": "^1.2",
        "pestphp/pest": "^3.0",
        "tastyigniter/core": "^v4.0"
    },
    "autoload": {
        "psr-4": {
            "Tipowerup\\Testbench\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tipowerup\\Testbench\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "composer/installers": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test:lint": "vendor/bin/pint --test --ansi",
        "test:lint-fix": "vendor/bin/pint --ansi",
        "test:pest": "vendor/bin/pest --compact",
        "test": [
            "@test:lint",
            "@test:pest"
        ]
    }
}
